{
  "name": "sendora-backend",
  "version": "1.0.0",
  "description": "SENDORA - Bulk SMS Platform Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon src/server.ts",
    "worker": "ts-node src/start-worker.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker\"",
    "start:worker": "node dist/start-worker.js",
    "build": "tsc",
    "migrate": "ts-node src/scripts/runMigration.ts",
    "start": "node dist/server.js",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "db:sync": "npx ts-node src/utils/dbSync.ts",
    "db:sync:force": "npx ts-node -e \"import { syncDatabase } from './src/utils/dbSync'; syncDatabase(true);\"",
    "db:reset": "echo '⚠️  Use db:reset:force to actually reset data (WARNING: DELETES ALL DATA)'",
    "db:reset:force": "npx ts-node -e \"import { sequelize } from './src/config/sequelize'; import './src/models'; sequelize.sync({ force: true }).then(() => { console.log('✅ Database reset complete'); process.exit(0); })\"",
    "db:seed": "npx ts-node database/seeds/index.ts",
    "db:seed:users": "npx ts-node database/seeds/index.ts --skip-gateways --skip-contacts --skip-campaigns",
    "db:seed:gateways": "npx ts-node database/seeds/index.ts --skip-users --skip-contacts --skip-campaigns",
    "db:seed:contacts": "npx ts-node database/seeds/index.ts --skip-users --skip-gateways --skip-campaigns",
    "db:seed:campaigns": "npx ts-node database/seeds/index.ts --skip-users --skip-gateways --skip-contacts",
    "db:seed:all": "npx ts-node database/seeds/index.ts",
    "start:dev": "concurrently \"npm run dev\" \"npm run worker\"",
    "health": "curl -f http://localhost:3000/health || echo 'Service is down'"
  },
  "dependencies": {
    "@faker-js/faker": "^8.2.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "africastalking": "^0.7.9",
    "axios": "^1.13.5",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "bullmq": "^4.8.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dayjs": "^1.11.9",
    "dotenv": "^16.0.3",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^6.7.0",
    "express-validator": "^6.14.3",
    "file-saver": "^2.0.5",
    "handlebars": "^4.7.8",
    "helmet": "^7.0.0",
    "html-to-text": "^9.0.5",
    "ioredis": "^5.10.0",
    "json2csv": "^6.0.0-alpha.2",
    "jsonwebtoken": "^9.0.0",
    "juice": "^11.1.1",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.11.0",
    "pg-pool": "^3.6.1",
    "qrcode": "^1.5.4",
    "rate-limiter-flexible": "^2.4.2",
    "react-hot-toast": "^2.6.0",
    "redis": "^5.11.0",
    "sequelize": "^6.32.1",
    "socket.io": "^4.8.3",
    "socket.io-redis": "^6.1.1",
    "speakeasy": "^2.0.0",
    "stripe": "^12.16.0",
    "twilio": "^5.12.1",
    "uuid": "^9.0.0",
    "winston": "^3.10.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.2",
    "@types/cors": "^2.8.13",
    "@types/express": "^5.0.6",
    "@types/file-saver": "^2.0.7",
    "@types/helmet": "^4.0.0",
    "@types/html-to-text": "^9.0.4",
    "@types/ioredis": "^5.0.0",
    "@types/json2csv": "^5.0.7",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.5.0",
    "@types/nodemailer": "^7.0.11",
    "@types/pg": "^8.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/speakeasy": "^2.0.10",
    "@types/uuid": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^6.3.0",
    "@typescript-eslint/parser": "^6.3.0",
    "concurrently": "^8.2.1",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "newman": "^5.3.2",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.2",
    "sequelize-cli": "^6.6.1",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
