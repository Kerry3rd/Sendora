# ============================================
# DEVELOPMENT ENVIRONMENT
# ============================================

# Override any development-specific variables here
NODE_ENV=development
DEBUG=true

# Use virtual gateway for development
VIRTUAL_GATEWAY_ENABLED=true
TWILIO_ENABLED=false
MESSAGEBIRD_ENABLED=false

# Disable real payments in development
# STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXXXXXX
MPESA_ENVIRONMENT=sandbox

# Development database
DB_NAME=bulksms_dev

# Disable email verification in development
REQUIRE_EMAIL_VERIFICATION=false

# Increase limits for testing
MAX_CONTACTS_PER_UPLOAD=50000

# Development admin credentials
ADMIN_EMAIL=admin@bulksms.com
ADMIN_PASSWORD=Admin@123
ADMIN_PHONE=+255123456789
